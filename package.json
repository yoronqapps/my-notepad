{
  "name": "notepad-app",
  "version": "1.0.0",
  "description": "My Notepad",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.yourname.notepad",
    "productName": "Notepad",
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "*",
    "electron-builder": "*"
  }
}